# Vendored Helm dependencies. Chart.lock pins the exact versions; restore the
# archives with `helm dependency build k8s/inference-pipeline` (scripts/2-deploy.sh
# does this for you).
k8s/inference-pipeline/charts/*.tgz

# Local credential overrides. The chart ships no default passwords; copy
# values.local.example.yaml to values.local.yaml and fill it in.
k8s/inference-pipeline/values.local.yaml

# Local agent/session state
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# uv writes this whenever it sees pyproject.toml and treats the directory as a
# project. This repo declares no dependencies -- pyproject.toml holds only ruff
# and pytest config -- so the lock pins nothing and its inferred
# `requires-python` can disagree with ruff's `target-version`. Test dependencies
# are installed explicitly (see the README and the CI `tests` job).
uv.lock

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
